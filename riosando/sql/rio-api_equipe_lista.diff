+// equipe = allowlist fixa OU e-mail ativo na tabela `equipe` (login Google individual — 21/11/2026).
+// Cache de 60s pra não bater no banco a cada clique do painel.
+let _equipeCache: { em: number; emails: Set<string> } | null = null;
+async function emailsEquipe(): Promise<Set<string>> {
+  if (_equipeCache && Date.now() - _equipeCache.em < 60_000) return _equipeCache.emails;
+  try {
+    const l = await rows(await pg(`/equipe?ativo=eq.true&select=email`));
+    _equipeCache = { em: Date.now(), emails: new Set(l.map((x: any) => String(x.email).toLowerCase())) };
+  } catch { _equipeCache = { em: Date.now(), emails: new Set() }; }
+  return _equipeCache.emails;
+}
